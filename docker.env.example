# Copy to .env and fill in values for your deployment.
# This lists the environment variables used by Tesbo Test Manager (including
# production-style deployments such as app.tesbo.io). Leave secrets empty until
# you set your own — never commit a real .env.

# -----------------------------------------------------------------------------
# Ports (host bindings for docker-compose)
# -----------------------------------------------------------------------------
FRONTEND_PORT=1010
BACKEND_PORT=1011
REDIS_PORT=6379
# Optional if you run a local Postgres container instead of Neon/external DB:
POSTGRES_PORT=5432

# -----------------------------------------------------------------------------
# Database
# Current docker-compose expects an external Postgres (e.g. Neon) via DATABASE_*.
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_USER=
DATABASE_PASSWORD=
# Optional legacy local-postgres style vars (not used by current compose DATABASE_* path):
POSTGRES_DB=tesbo
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# Public URLs (browser-facing)
# Local example below. Production uses https://app.tesbo.io and https://api-app.tesbo.io.
# -----------------------------------------------------------------------------
FRONTEND_URL=http://localhost:1010
NEXT_PUBLIC_API_URL=http://localhost:1011
CORS_ALLOWED_ORIGINS=http://localhost:1010,http://127.0.0.1:1010,http://localhost:3000,http://127.0.0.1:3000

# -----------------------------------------------------------------------------
# Email (Postmark)
# -----------------------------------------------------------------------------
POSTMARK_API_TOKEN=
POSTMARK_FROM_EMAIL=noreply@example.com
# live | log (default: log).
#   live — every email is delivered for real. PRODUCTION MUST SET THIS; nothing else should.
#   log  — the OTP is printed to the backend log and never emailed at all, and the remaining
#          emails (invite, billing, storage) are posted to Postmark only after Postmark confirms
#          the token belongs to a SANDBOX server, which accepts sends and delivers to nobody.
#          A live token in this mode sends nothing. This is what makes a test run unable to bounce.
EMAIL_DELIVERY_MODE=log

# -----------------------------------------------------------------------------
# Auth / session
# -----------------------------------------------------------------------------
OTP_EXPIRY_MINUTES=10
SESSION_DAYS=30

# -----------------------------------------------------------------------------
# Uploads
# -----------------------------------------------------------------------------
UPLOAD_DIR=./uploads
# Max size (bytes) for a single uploaded file. 104857600 = 100MB.
MAX_UPLOAD_SIZE=104857600

# -----------------------------------------------------------------------------
# Platform OAuth (Jira / Linear)
# Register FRONTEND_URL + /integrations/callback in each provider console.
# *_REDIRECT_URI are optional overrides — derived from FRONTEND_URL when unset.
# -----------------------------------------------------------------------------
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
JIRA_REDIRECT_URI=
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
LINEAR_REDIRECT_URI=

# -----------------------------------------------------------------------------
# BetterBugs widget (frontend build-time). Leave blank to disable.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_BETTERBUGS_API_KEY=
NEXT_PUBLIC_BETTERBUGS_PROJECT_ID=

# -----------------------------------------------------------------------------
# Sentry (frontend build-time) — STAGE ONLY
# Set BOTH on app-stage.tesbo.io. Leave BOTH empty on production (app.tesbo.io)
# so the SDK never initializes and no events are sent from prod.
#   NEXT_PUBLIC_SENTRY_ENVIRONMENT must be exactly "stage" (any other value = off)
# Optional: SENTRY_AUTH_TOKEN for source-map uploads during stage builds only.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
# SENTRY_AUTH_TOKEN=

# -----------------------------------------------------------------------------
# Stripe billing (Tesbo Cloud plans)
# STRIPE_WEBHOOK_SECRET from `stripe listen` (local) or Dashboard webhook (prod).
# INR price IDs: set BOTH or neither (India pricing).
# BILLING_FORCE_COUNTRY: empty in production; use IN only for local/staging tests.
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO_MONTHLY=
STRIPE_PRICE_ID_PRO_ANNUAL=
STRIPE_PRICE_ID_PRO_MONTHLY_INR=
STRIPE_PRICE_ID_PRO_ANNUAL_INR=
BILLING_FORCE_COUNTRY=
TRUST_PROXY_COUNTRY_HEADER=false
PLAN_GRACE_DAYS=30
SUPPORT_CONTACT_EMAIL=support@example.com

# -----------------------------------------------------------------------------
# Secrets at rest (MCP / API tokens / integration secrets)
# Generate with: openssl rand -base64 32
# -----------------------------------------------------------------------------
SECRETS_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# Object storage (Knowledge Base + files)
# STORAGE_DRIVER=local keeps files on the Docker volume (no S3 needed).
# STORAGE_DRIVER=s3 requires the S3_* (and optionally AWS_* / TESBO_*) vars below.
# -----------------------------------------------------------------------------
STORAGE_DRIVER=local
S3_BUCKET=
S3_BUCKET_FOLDER=
S3_BUCKET_NAME=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
S3_PRESIGNED_URL_TTL_SECONDS=300

# Legacy / compatibility AWS vars (same credentials as S3_* when used)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Legacy Tesbo artifact storage (Spaces / S3-compatible)
TESBO_ARTIFACT_STORAGE_PROVIDER=
TESBO_SPACES_ENDPOINT=
TESBO_SPACES_REGION=
TESBO_SPACES_BUCKET=
TESBO_SPACES_ACCESS_KEY=
TESBO_SPACES_SECRET_KEY=
TESBO_SIGNED_URL_TTL_SECONDS=600
