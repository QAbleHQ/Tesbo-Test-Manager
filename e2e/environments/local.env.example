# The local docker-compose stack. Copy to e2e/environments/local.env — this is the environment a
# bare `npx playwright test` uses, because `local` is the default when E2E_ENV is unset.
#
# Creating it matters more than it looks. Without this file the suite falls back to the hardcoded
# defaults in utils/env.ts, which are :1010/:1011 — the OPEN-SOURCE stack's ports. This stack is
# :1020/:1021. A run that takes the fallback therefore talks to nothing, decides the target is
# "local" anyway, switches auto-provisioning on, and dies in global-setup with "Provisioned <user>
# but the follow-up password login still failed".
#
# Leave a value EMPTY to mean "not configured" — the loader skips empty lines rather than assigning
# "", so the fallback behind them still applies.

API_BASE_URL=http://localhost:1021
WEB_BASE_URL=http://localhost:1020

# Left empty on purpose: for a localhost target utils/env.ts falls back to the repo-root .env, which
# is the one database this stack is allowed to touch. Setting it here would just duplicate that, and
# a stale copy would point the fixtures at the wrong server — the failure mode CLAUDE.md's database
# rule exists to prevent.
E2E_DATABASE_URL=

# Project API token for @tesbox/playwright-reporter (Project -> Settings -> API & MCP, read+write).
# The reporter's other two values are committed in playwright.config.ts; only this one is a secret.
# Leave it empty here and inject it as a credential in CI — process.env wins over this file.
TESBO_API_TOKEN=
