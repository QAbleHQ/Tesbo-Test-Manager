# Staging. Copy to e2e/environments/stage.env (gitignored) and fill in the secrets.
#
# Selected with E2E_ENV=stage. Anything already present in the process environment WINS over this
# file, so a CI job should inject the three secrets below as credentials and let this file supply
# only the rest. Never commit a password or a connection string.

API_BASE_URL=https://api-app-stage.tesbo.io
WEB_BASE_URL=https://app-stage.tesbo.io

# Mail domain for every address the suite invents. Must accept mail without bouncing — the suite
# once accumulated ~1100 bounces against a domain that did not exist. mailinator.com is the default.
E2E_EMAIL_DOMAIN=mailinator.com

# --- Account A: the workspace nearly every spec runs in --------------------------------------
# Must already exist on the target UNLESS E2E_DATABASE_URL is set, in which case global-setup seeds
# it. E2E_PROJECT_NAME should name a project this account already owns: a launch-plan workspace has
# a 2-project ceiling, so letting the suite create one leaves no spare slot for specs that need one.
E2E_TEST_EMAIL=
E2E_TEST_PASSWORD=
E2E_ORG_NAME=Testing Stagging 105070
E2E_PROJECT_NAME=First project

# --- Account B: only so api/authorization.spec.ts can prove B cannot reach A's data ----------
# Must be a genuinely separate workspace, not a member of A's.
E2E_TEST_EMAIL_B=
E2E_TEST_PASSWORD_B=
E2E_ORG_NAME_B=Testing Stagging 205070
E2E_PROJECT_NAME_B=Testing Stagging

# --- The database, and what it unlocks -------------------------------------------------------
#
# THE single most consequential value here. utils/psql.ts now connects directly (utils/pg-runner.js)
# rather than through `docker compose exec`, so this alone makes all 46 DB-backed spec files — 1064
# tests — runnable from a CI agent with no Docker. Left empty, those files skip themselves and every
# tenant must pre-exist.
#
# It also means those specs INSERT, UPDATE and DELETE in the STAGE database: seeding OTP codes,
# clearing rate-limit buckets, rewriting plan columns, deleting fixture tenants. Scoped to the
# disposable tenants the suite provisions, but real writes to shared infrastructure all the same.
E2E_DATABASE_URL=

# Pin the transport in CI. Without this a bad connection string silently falls back to a Docker that
# is not there, and 46 spec files skip while the job still reports success.
E2E_DB_TRANSPORT=direct

# --- Never enable against a shared environment -----------------------------------------------
# A Checkout Session against a live key creates a real Customer and permanently pins that
# workspace's billing currency. scripts/e2e-ci.sh refuses to start if this is true.
E2E_BILLING_ALLOW_STRIPE_WRITES=false

# Project API token for @tesbox/playwright-reporter (Project -> Settings -> API & MCP, read+write).
# The reporter's other two values are committed in playwright.config.ts; only this one is a secret.
# Leave it empty here and inject it as a credential in CI — process.env wins over this file.
#
# Empty here is not the same as "reporting is off": e2e/tesbo.config.json (written by
# `npx @tesbox/playwright-reporter init`, gitignored) can supply all three values instead, and
# playwright.config.ts enables the reporter when either source carries a token. Check with
# `npx @tesbox/playwright-reporter doctor` in e2e/ before assuming a run will report.
TESBO_API_TOKEN=
