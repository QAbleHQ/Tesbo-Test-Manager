{
  "name": "tesbo-e2e",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "scripts": {
    "test": "playwright test",
    "test:api": "playwright test --project=api",
    "test:ui": "playwright test --project=ui",
    "test:local": "E2E_ENV=local playwright test",
    "test:stage": "E2E_ENV=stage playwright test",
    "test:stage:regression": "E2E_ENV=stage playwright test regression/",
    "env:check": "playwright test --list --reporter=null",
    "report": "playwright show-report",
    "install-browsers": "playwright install chromium",
    "coverage": "node --experimental-strip-types --no-warnings scripts/coverage-report.ts",
    "coverage:gate": "node --experimental-strip-types --no-warnings scripts/coverage-report.ts --min-api 100 --min-ui 100",
    "coverage:audit": "node --experimental-strip-types --no-warnings scripts/coverage-report.ts --audit"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tesbox/playwright-reporter": "^0.2.0",
    "@types/node": "^22.10.7",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.0",
    "typescript": "^5.7.3",
    "xlsx": "^0.18.5"
  }
}
