PORT=7000

# PostgreSQL
# Use JDBC URL format. Example:
# DATABASE_URL=jdbc:postgresql://db-host:5432/bettercases?sslmode=require
DATABASE_URL=jdbc:postgresql://your-postgres-host:5432/bettercases?sslmode=require
DATABASE_USER=postgres
DATABASE_PASSWORD=changeme

# CORS and app URLs
# Exact origins (scheme + host, no path). Main app must match FRONTEND_URL.
CORS_ALLOWED_ORIGINS=https://app.example.com
FRONTEND_URL=https://app.example.com

# Auth/session
SESSION_DAYS=30

# Email (OTP and alerts)
POSTMARK_API_TOKEN=
POSTMARK_FROM_EMAIL=noreply@example.com
# REQUIRED IN PRODUCTION. Without "live" the backend will not deliver mail: it defaults to "log",
# which prints OTPs to the log and only replays other emails through a Postmark sandbox server. That
# default protects local and CI stacks from bouncing mail off test addresses — a real deployment has
# to opt in to sending. Confirm it took effect from the boot log line "[email] delivery mode=live
# postmark_server=live reach=recipients", or from GET /api/admin/system/health.
EMAIL_DELIVERY_MODE=live
# Optional CC on the welcome email sent to each new user 3h after registration. Comma-separated list OK.
WELCOME_EMAIL_CC=

# Daily Basecamp analytics report, posted at 00:10 IST for the previous IST day. PRODUCTION ONLY: this
# template is the production one, so it is on here; every other environment leaves it unset (off).
# BASECAMP_REFRESH_TOKEN is exchanged for a fresh access token on every run, so no access token is
# stored. Without all four BASECAMP_* values the job logs one warning and does not schedule.
ANALYTICS_REPORT_ENABLED=true
BASECAMP_CLIENT_ID=
BASECAMP_CLIENT_SECRET=
BASECAMP_REFRESH_TOKEN=
BASECAMP_ACCOUNT_ID=

# Platform OAuth apps (optional). Set the client id/secret and workspace owners connect with a
# single Connect click instead of registering their own OAuth app. Register
# FRONTEND_URL + /integrations/callback as the callback URL in the provider console.
# *_REDIRECT_URI is an optional override — derived from FRONTEND_URL when left blank.
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
JIRA_REDIRECT_URI=

LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
LINEAR_REDIRECT_URI=

NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=

# Knowledge Base file storage
# local: saves under /app/uploads (mounted to ./uploads in compose) — no further config needed.
# s3: stores in any S3-compatible service (AWS S3, DigitalOcean Spaces, MinIO, Cloudflare R2,
#     Backblaze B2, ...). Files are served via short-lived presigned URLs, never public links.
STORAGE_DRIVER=local
S3_BUCKET=
# Optional key prefix so multiple environments can share one bucket without colliding.
S3_BUCKET_FOLDER=
S3_REGION=us-east-1
# Only needed for non-AWS S3-compatible endpoints (DigitalOcean Spaces, MinIO, R2, etc.)
S3_ENDPOINT=
# Leave blank to use the default AWS credential chain (IAM role, shared config, etc.) instead.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Set to true for MinIO and some other S3-compatible services.
S3_FORCE_PATH_STYLE=false
S3_PRESIGNED_URL_TTL_SECONDS=600
