PORT=7000
DATABASE_URL=postgresql://localhost:5432/tesbo
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
POSTMARK_API_TOKEN=
POSTMARK_FROM_EMAIL=noreply@example.com
# live | log (default: log). Only production sets "live". In "log" the OTP is printed to the backend
# log and never emailed, and other emails are posted only to a Postmark SANDBOX server, which
# delivers to nobody — so no test run can bounce mail. Use a sandbox server token here.
EMAIL_DELIVERY_MODE=log
# Welcome email, sent to the registering user 3 hours after they sign up. Optional CC (comma-separated
# list accepted); leave blank for none.
WELCOME_EMAIL_CC=
OTP_EXPIRY_MINUTES=10
# Server-side calls to an AI provider's base URL refuse private and internal addresses (loopback, 10/8,
# 192.168/16, Docker service names ...) and plain http, so a workspace owner cannot point the server at its own
# network. Set to true ONLY for a self-hosted runtime on your own network (Ollama, LM Studio, vLLM) or a
# local/e2e stack with a fake provider. Cloud metadata and link-local addresses stay blocked either way.
ALLOW_PRIVATE_AI_HOSTS=false
# Brute-force limits count FAILED guesses only (wrong password, wrong code, unknown token or email), so they never
# affect a signed-in user or a successful login. Set RATE_LIMIT_ENABLED=false to switch every counter off.
# RATE_LIMIT_IP_MULTIPLIER scales the per-IP caps for a stack where many clients share one address (CI, e2e).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_IP_MULTIPLIER=1
SESSION_DAYS=30
CORS_ALLOWED_ORIGINS=http://localhost:1010,http://127.0.0.1:1010,http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:1010
# Platform OAuth apps for Jira/Linear. Register the app once (Atlassian Developer Console /
# Linear Settings → API), put the credentials here, and every workspace owner connects with a
# single Connect click — no per-workspace client id/secret entry. Leave blank and owners fall
# back to bringing their own OAuth app from Workspace Settings → Integrations.
#
# The callback URL to register in the provider console is FRONTEND_URL + /integrations/callback.
# *_REDIRECT_URI is optional and only needed to override that (e.g. a proxy on another host).
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
JIRA_REDIRECT_URI=
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
LINEAR_REDIRECT_URI=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=
# AES-256-GCM key used to encrypt integration secrets (OAuth tokens, personal access tokens)
# at rest. Generate with: openssl rand -base64 32
SECRETS_ENCRYPTION_KEY=
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=52428800
# Object storage for Knowledge Base files. Defaults to local disk (UPLOAD_DIR above).
# Set STORAGE_DRIVER=s3 to use any S3-compatible service (AWS S3, MinIO, Cloudflare R2,
# DigitalOcean Spaces, Backblaze B2, ...). Files are stored under a per-project prefix
# (knowledge-base/<organizationId>/<projectId>/...) and are only ever served via short-lived presigned URLs
# issued after the request passes project access + role checks.
STORAGE_DRIVER=local
S3_BUCKET=
# Optional key prefix so multiple environments can share one bucket without colliding.
S3_BUCKET_FOLDER=
S3_REGION=us-east-1
# Only needed for non-AWS S3-compatible endpoints (MinIO, R2, Spaces, etc.)
S3_ENDPOINT=
# Omit to use the default AWS credential chain (IAM role, shared config, etc.)
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Set to true for MinIO and some other S3-compatible services
S3_FORCE_PATH_STYLE=false
# How long a signed download/preview link stays valid.
S3_PRESIGNED_URL_TTL_SECONDS=300
